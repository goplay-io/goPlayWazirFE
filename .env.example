VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_CURRENCY=INR
VITE_MOBILE_APP_KEY=zuplay
# Optional when the public API uses a different origin from VITE_API_BASE_URL.
# VITE_PUBLIC_API_BASE=http://localhost:4000

VITE_EVENT_BASE=http://localhost:4000/event
VITE_USER_BASE=http://localhost:4000/user
VITE_REPORT_BASE=http://localhost:4000/report
VITE_WALLET_BASE=http://localhost:4000/wallet

VITE_USE_ORIGINAL_IMAGE_URL=true

# OddsDistributor WebSocket (real-time odds)
VITE_ODDS_WS_URL=ws://localhost:8080

# Signup domain (used to resolve white label for self-signup)
VITE_SIGNUP_DOMAIN=localhost:5173

# Optional override. Defaults to the client app type constant.
VITE_AUTH_STORAGE_NAMESPACE=client

# Base CSRF cookie name. The backend will namespace it automatically per app.
VITE_CSRF_COOKIE_NAME=csrf_token

# Header site switcher (logged-in users). Defaults match goplay99 production URLs.
# VITE_GOPLAY_SITE_URL=https://goplaybet.io/
# VITE_DIAMOND_SITE_URL=https://diamond.goplaybet.io/
# VITE_WINBUZZ_SITE_URL=https://winbuzz.goplaybet.io/
# VITE_FAIRPLAY_SITE_URL=https://fairplay.goplaybet.io/
# VITE_REDDY_SITE_URL=https://reddy.goplaybet.io/
# VITE_ZUPLAY_SITE_URL=https://zuplay.com/
